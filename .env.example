# DeepSeek-QuantBot Çevre Değişkenleri Örneği

# Çalışma Modu: PAPER (Sanal Kasa) veya LIVE (Canlı Borsa)
TRADING_MODE=PAPER

# Canlı İşlem Borsası: AUTO (Akıllı Rota), BINANCE, MEXC, OKX
TRADING_EXCHANGE=AUTO

# DeepSeek & AI Ayarları
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-reasoner
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Groq Cloud Ultra Hızlı Acil Karar Motoru (Opsiyonel)
GROQ_API_KEY=

# FRED (Federal Reserve Economic Data) API Key (Opsiyonel)
FRED_API_KEY=

# CoinGecko API Key (Opsiyonel - Boşsa açık API kullanılır)
COINGECKO_API_KEY=

# Borsa API Anahtarları
BINANCE_API_KEY=
BINANCE_SECRET_KEY=

OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=

MEXC_API_KEY=
MEXC_SECRET_KEY=

# Telegram Bildirimleri (Opsiyonel)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Risk Yönetimi
AI_RISK_PROFILE=AGGRESSIVE_ALPHA
MAX_RISK_PER_TRADE_PERCENT=5.0
